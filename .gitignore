# Variáveis de ambiente (API keys, tokens — NUNCA commitar)
.env
.env.local
.env.*

# Arquivo gerado pelo /setup com MCPs específicos do usuário
_configurar-mcps.md

# Outputs de renderização (binários pesados)
*.png
# Versões leves geradas pelo otimizar.js: derivadas dos PNG, que também não sobem
conteudo/**/web/

# Arquivos de dados do usuário (CSVs, planilhas, etc)
dados/*.csv
dados/*.xlsx
dados/*.xls
dados/*.txt
dados/*.pdf
dados/*.json
!dados/README.md

# Pastas de trabalho: no repositório do curso elas eram ignoradas pra ninguém subir
# material pessoal. Aqui o repositório é meu e privado, então o trabalho PRECISA ser
# versionado, senão o /syncar não protege nada. Bloco removido de propósito.

# Skills: todas versionadas, inclusive as que eu criar com /mapear. São o ativo mais
# caro de recriar. (No kit original só as 6 originais subiam.)

# Ponte pro Codex enxergar as skills — criada pelo /setup em CADA máquina
# (symlink no Mac/Linux, cópia no Windows). Nunca vai pro git.
.agents/

# Arquivos gerados pelo uso/registro das skills (conteúdo pessoal, nunca no kit)
automacoes-dm.md
prioridades.md
contas.yaml

# Sistema
.DS_Store
node_modules/

# Permissões locais do Claude Code (pessoal desta máquina, nunca versionado)
.claude/settings.local.json

# Vídeo renderizado pela skill /reels: pesado e regerável a partir do plano.json
*.mp4

# Áudio de entrada da /reels: arquivo pessoal e pesado, o que importa é a transcrição
dados/audio/*
!dados/audio/README.md

# reels: artefatos de trabalho, regeráveis (prancha, folhas de busca, prévias de animação e B-roll)
conteudo/**/_prancha/
conteudo/**/_busca*/
*.revisao.jpg

# Carteira real e diario de decisoes (/analista-investimentos): dado financeiro pessoal, nunca sobe
financas/carteira/*
!financas/carteira/.gitkeep

# Cache do Python dos scripts das skills
__pycache__/

# Materiais de terceiros (e-books, artigos) usados como referência pela /analista-investimentos: uso interno, não redistribuir
financas/referencias/*.pdf
