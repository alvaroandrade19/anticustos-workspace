{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*credentials*)",
      "Read(./**/*secret*)"
    ]
  },
  "extraKnownMarketplaces": {
    "alexgreensh-token-optimizer": {
      "source": {
        "source": "github",
        "repo": "alexgreensh/token-optimizer"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "token-optimizer@alexgreensh-token-optimizer": true
  }
}
